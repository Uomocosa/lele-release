#!/usr/bin/env bash
# Generated by `lele-release setup`; machine-local, never committed.
# Runs @TOOL@ built from the sibling checkout, so a change there is picked up
# by every repo without `just install`. Set LELE_USE_INSTALLED=1 (or remove the
# sibling checkout) to run the installed binary instead.
set -euo pipefail

repo='@REPO@'
installed="${CARGO_HOME:-$HOME/.cargo}/bin/@TOOL@"

if [ "${LELE_USE_INSTALLED:-}" = "1" ] || [ ! -f "$repo/Cargo.toml" ]; then
    if [ ! -x "$installed" ]; then
        echo "@TOOL@: no sibling checkout at $repo and nothing installed at $installed" >&2
        exit 127
    fi
    exec "$installed" "$@"
fi

target="$repo/target"
(cd "$repo" && cargo build --quiet --package '@PACKAGE@' --target-dir "$target") >&2
exec "$target/debug/@TOOL@" "$@"
